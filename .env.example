# =============================================================================
# EV Wallet HK — Environment variables
# Copy this to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---- Postgres ----------------------------------------------------------------
POSTGRES_USER=evwallet
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=evwallet
POSTGRES_PORT=5432
# Bind only to loopback — Caddy reaches Postgres through Docker network
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# ---- Redis -------------------------------------------------------------------
REDIS_PASSWORD=change_me_strong_redis_password
REDIS_PORT=6379

# ---- FastAPI -----------------------------------------------------------------
# All env vars prefixed EVW_ to avoid collision with host
EVW_ENV=production
EVW_LOG_LEVEL=INFO
EVW_LOG_FORMAT=human
EVW_API_HOST=0.0.0.0
EVW_API_PORT=8000
EVW_WORKERS=3
# Comma-separated list of trusted IPs for X-Forwarded-For (Cloudflare edge IPs)
# See https://www.cloudflare.com/ips/ — regenerate quarterly
EVW_TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
# JWT secret — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
EVW_JWT_SECRET=change_me_to_random_64byte_urlsafe_string
EVW_JWT_EXPIRY_HOURS=720
# Wallet pre-authorization hold cap (HKD)
EVW_PREAUTH_MAX_HKD=500.00
# Top-up providers
EVW_STRIPE_SECRET_KEY=
EVW_STRIPE_WEBHOOK_SECRET=
EVW_APPLE_PAY_MERCHANT_ID=
EVW_GOOGLE_PAY_MERCHANT_ID=

# ---- n8n ---------------------------------------------------------------------
N8N_HOST=n8n.evwallet.com.hk
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=change_me_n8n_admin_password
N8N_ENCRYPTION_KEY=change_me_to_random_32byte_hex
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"

# ---- Cloudflare Tunnel -------------------------------------------------------
# Get from `cloudflared tunnel create ev-wallet` -> JSON file at ~/.cloudflared/
# Paste the contents of that JSON here. Cloudflared reads it directly.
CLOUDFLARED_TUNNEL_TOKEN=
# Hostnames that route to this tunnel (comma-separated)
EVW_HOSTNAMES=api.evwallet.com.hk,n8n.evwallet.com.hk

# ---- Backups -----------------------------------------------------------------
# Backblaze B2 (recommended for budget) — see docs/BACKUP.md
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=ev-wallet-backups
B2_PATH_PREFIX=mac-mini-prod
# Local backup directory (must be on a separate physical volume in prod)
BACKUP_LOCAL_DIR=/Users/hermes/ev-wallet/backups
# Retention
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4
BACKUP_RETAIN_MONTHLY=6

# ---- Domain (informational only) --------------------------------------------
EVW_PUBLIC_DOMAIN=evwallet.com.hk